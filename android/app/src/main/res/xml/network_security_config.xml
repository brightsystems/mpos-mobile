<?xml version="1.0" encoding="utf-8"?>
<!-- Release and profile builds: HTTPS only (no plain HTTP to any host), system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
