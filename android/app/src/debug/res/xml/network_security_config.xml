<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allows plain HTTP so the app can reach a local API on the LAN
     (MPOS_API_URL=http://192.168.x.x:5150 passed as a dart define). Release builds use
     src/main/res/xml/network_security_config.xml, which forbids it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
